# 장비 시뮬레이터 설정. 복사해서 .env.simulator 로 저장 (gitignore 대상).
# SIM_KEY_*: 관리자 > 장비 > 새 API 키 발급 값
# SUPABASE_URL이 localhost/127.0.0.1이 아니면 실행이 거부된다 (가짜 데이터가 실제 KPI에 섞임 방지).
# 원격 대상이 의도된 경우에만 --allow-remote 를 붙여 실행한다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SIM_KEY_PACKAGING_01=
SIM_KEY_VISION_01=
SIM_KEY_CASER_01=
SIM_KEY_TAPER_01=
SIM_KEY_WRAPPER_01=
SIM_KEY_CONVEYOR_01=
